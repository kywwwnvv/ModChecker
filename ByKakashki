    local function createExpandableTab(icon, label, order, panelName)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(0,42,0,40)
        b.BackgroundColor3 = COLORS.IconBg
        b.BackgroundTransparency = 1
        b.BorderSizePixel = 0
        b.Text = ""
        b.AutoButtonColor = false
        b.LayoutOrder = order
        b.ClipsDescendants = true
        b.ZIndex = 10
        b.Parent = Container
        local stroke = roundStroke(b, UDim.new(1,0))
        stroke.Transparency = 1

        local ic = Instance.new("TextLabel")
        ic.Size, ic.BackgroundTransparency = UDim2.new(0,38,1,0), 1
        ic.Text, ic.TextColor3, ic.TextSize = icon, COLORS.Text, 16
        ic.Font, ic.Parent = Enum.Font.GothamBold, b
        ic.ZIndex = 11
        ic.TextTransparency = 1

        local lbl = Instance.new("TextLabel")
        lbl.Size, lbl.Position, lbl.BackgroundTransparency = UDim2.new(0,100,1,0), UDim2.new(0,38,0,0), 1
        lbl.Text, lbl.TextColor3, lbl.TextSize = label, COLORS.Text, 12
        lbl.Font, lbl.TextXAlignment, lbl.TextTransparency = Enum.Font.GothamBold, Enum.TextXAlignment.Left, 1
        lbl.Parent = b
        lbl.ZIndex = 11

        local expanded = false
        track(b.MouseEnter:Connect(function()
            if expanded then return end
            expanded = true
            TweenService:Create(b, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {Size=UDim2.new(0,110,0,40), BackgroundColor3=COLORS.IconHover}):Play()
            TweenService:Create(lbl, TweenInfo.new(0.2), {TextTransparency=0}):Play()
            TweenService:Create(stroke, TweenInfo.new(0.2), {Color=COLORS.Accent, Transparency=0}):Play()
        end))
        track(b.MouseLeave:Connect(function()
            if not expanded then return end
            expanded = false
            TweenService:Create(b, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {Size=UDim2.new(0,42,0,40), BackgroundColor3=COLORS.IconBg}):Play()
            TweenService:Create(lbl, TweenInfo.new(0.15), {TextTransparency=1}):Play()
            TweenService:Create(stroke, TweenInfo.new(0.2), {Color=COLORS.Outline, Transparency=0.5}):Play()
        end))
        track(b.MouseButton1Click:Connect(function()
            togglePanel(panelName)
        end))

        return b, ic, lbl, stroke
    end

