                    total = total + h + 6
                end
            end
            return total
        end
        scriptScroll.CanvasSize = UDim2.new(0, 0, 0, calc(scriptScroll) + 12)
        playerScroll.CanvasSize = UDim2.new(0, 0, 0, calc(playerScroll) + 12)
    end
