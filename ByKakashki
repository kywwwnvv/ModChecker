-- Простая хеш-функция FNV-1a + микс (1-в-1 как в JS)
local function simpleHash(str, seed)
    local h = bit32.band(seed or 0x811C9DC5, 0xFFFFFFFF)
    for i = 1, #str do
        local byte = string.byte(str, i)
        h = bit32.bxor(h, byte)
        h = bit32.band(h * 0x01000193, 0xFFFFFFFF)
        h = bit32.bxor(h, bit32.rshift(h, 13))
        h = bit32.band(h * 0x5BD1E995, 0xFFFFFFFF)
    end
    h = bit32.bxor(h, bit32.rshift(h, 16))
    h = bit32.band(h * 0x85EBCA6B, 0xFFFFFFFF)
    h = bit32.bxor(h, bit32.rshift(h, 13))
    h = bit32.band(h * 0xC2B2AE35, 0xFFFFFFFF)
    h = bit32.bxor(h, bit32.rshift(h, 16))
    return bit32.band(h, 0xFFFFFFFF)
end

-- Генерация ключа по индексу
local function generateKey(index)
    local input = KEY_PREFIX .. tostring(index) .. "_" .. SECRET
    local h1 = simpleHash(input, 0x811C9DC5)
    local h2 = simpleHash(input .. "_salt", 0x12345678)
    local h3 = simpleHash(tostring(h1) .. tostring(h2), 0xDEADBEEF)

    local combined = bit32.bxor(h1, bit32.lshift(h2, 7))
    combined = bit32.bxor(combined, bit32.rshift(h3, 3))
    combined = bit32.band(combined, 0xFFFFFFFF)

    local hex = string.format("%08X", combined)
    return string.lower(string.sub(hex, 1, KEY_LENGTH))
end

-- Кэш валидных ключей (считаем один раз)
local VALID_KEYS_CACHE = {}
local KEYS_BUILT = false

local function buildValidKeys()
    if KEYS_BUILT then return end
    KEYS_BUILT = true
    for i = 1, MAX_KEY_INDEX do
        VALID_KEYS_CACHE[generateKey(i)] = true
    end
end

local function isValidKey(key)
    if not key or key == "" then return false end
    key = key:gsub("%s+", ""):lower()
    buildValidKeys()
    return VALID_KEYS_CACHE[key] == true
end

-- ===================== HWID BOUND KEYS SYSTEM =====================
local USED_KEYS_FILE = "ModCheckerUsedKeys.txt"
local KEY_COOLDOWN = 48 * 60 * 60 -- 48 часов

local function getHWID()
    local ok, id = pcall(function()
        return RbxAnalyticsService:GetClientId()
    end)
    if ok and id and id ~= "" then
        return id
    end
    return "unknown_" .. tostring(plr.UserId)
end

local MY_HWID = getHWID()

local function loadUsedKeys()
    local map = {}
    pcall(function()
        if isfile(USED_KEYS_FILE) then
            local content = readfile(USED_KEYS_FILE)
            for line in content:gmatch("[^\r\n]+") do
                local key, hwid, ts = line:match("^([^|]+)|([^|]+)|(%d+)$")
                if key and hwid and ts then
                    map[key] = { hwid = hwid, ts = tonumber(ts) }
                end
            end
        end
    end)
    return map
end

local function saveUsedKeys(map)
    pcall(function()
        local lines = {}
        for k, v in pairs(map) do
            lines[#lines+1] = k .. "|" .. v.hwid .. "|" .. v.ts
        end
        writefile(USED_KEYS_FILE, table.concat(lines, "\n"))
    end)
end

local function markKeyUsed(key)
    local map = loadUsedKeys()
    map[key] = { hwid = MY_HWID, ts = os.time() }
    saveUsedKeys(map)
end

-- Возвращает: used (true/false), reason ("other_device" / "cooldown" / nil)
local function isKeyUsedOrExpired(key)
    local map = loadUsedKeys()
    local entry = map[key]
    if not entry then return false, nil end

    if entry.hwid ~= MY_HWID then
        return true, "other_device"
    end

    local elapsed = os.time() - entry.ts
    if elapsed >= KEY_COOLDOWN then
        return false, nil
    end
    return true, "cooldown"
end

