        pd.frame.Position = UDim2.new(0.5, -ROOT_WIDTH/2, 1, -PANEL_BOTTOM_GAP - pd.targetHeight)
        TweenService:Create(pd.frame, TweenInfo.new(OPEN_TIME, Enum.EasingStyle.Quad), {
            Size = UDim2.new(0, ROOT_WIDTH, 0, pd.targetHeight)
        }):Play()

        if name == "ScriptLog" or name == "PlayerLog" then
            task.delay(OPEN_TIME + 0.1, function()
                if _G.__ModChecker_updateLogCanvas then _G.__ModChecker_updateLogCanvas() end
            end)
        end
    end

    local function closePanelAndWait(name)
        local pd = panels[name]
        if not pd then return end
        if not pd.frame.Visible then return end

        local tween = TweenService:Create(pd.frame, TweenInfo.new(CLOSE_TIME, Enum.EasingStyle.Quad), {
            Size = UDim2.new(0, ROOT_WIDTH, 0, 0)
        })
        tween:Play()
        tween.Completed:Wait()

        pd.frame.Visible = false
    end

    local function togglePanel(name)
        local pd = panels[name]
        if not pd then return end
        if isSwitching then return end

        if currentPanel == name and pd.frame.Visible then
            isSwitching = true
            task.spawn(function()
                closePanelAndWait(name)
                currentPanel = nil
                isSwitching = false
            end)
            return
        end

        isSwitching = true
        task.spawn(function()
            if currentPanel and panels[currentPanel] and panels[currentPanel].frame.Visible then
                closePanelAndWait(currentPanel)
            end

            openPanel(name)
            currentPanel = name

            task.wait(OPEN_TIME)
            isSwitching = false
        end)
    end

