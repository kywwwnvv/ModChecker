    local function applyAnonText(o)
        if not (o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox")) then return end
        if not anonMode then return end

        if originalTexts[o] == nil then
            originalTexts[o] = o.Text
        end

        local base = originalTexts[o]
        if base == "" then return end

        local newText = base

        for other, data in pairs(otherPlayersNames) do
            if other and other.Parent then
                if newText:find(data.name, 1, true) then newText = newText:gsub(data.name, data.fake) end
                if newText:find(data.display, 1, true) then newText = newText:gsub(data.display, data.fake) end
            end
        end

        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= plr and not otherPlayersNames[p] then
                if newText:find(p.Name, 1, true) or newText:find(p.DisplayName, 1, true) then
                    hidePlayerName(p)
                    local fake = otherPlayersNames[p].fake
                    newText = newText:gsub(p.Name, fake):gsub(p.DisplayName, fake)
                end
            end
        end

        if newText:find(originalName, 1, true) then newText = newText:gsub(originalName, "???") end
        if newText:find(originalDisplay, 1, true) then newText = newText:gsub(originalDisplay, "???") end

        if newText ~= o.Text then
            o.Text = newText
        end
    end

    local function watchTextObject(o)
        if not (o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox")) then return end
        if textWatchers[o] then return end

        if originalTexts[o] == nil then
            originalTexts[o] = o.Text
        end

        applyAnonText(o)

        local conn = o:GetPropertyChangedSignal("Text"):Connect(function()
            if not anonMode then return end
            applyAnonText(o)
        end)
        textWatchers[o] = conn

        o.Destroying:Connect(function()
            if textWatchers[o] then
                if textWatchers[o].Connected then textWatchers[o]:Disconnect() end
                textWatchers[o] = nil
            end
            originalTexts[o] = nil
        end)
    end

    local function watchAllTextObjects()
        for _, o in ipairs(game:GetDescendants()) do
            watchTextObject(o)
        end
    end

    local function anonStrip()
        local char = plr.Character
        if not char then return end
        for _, o in ipairs(char:GetDescendants()) do
            if isAnonTarget(o) then o:Destroy() end
        end
        local head = char:FindFirstChild("Head")
        if head then
            for _, g in ipairs(head:GetChildren()) do
                if g:IsA("BillboardGui") then g:Destroy() end
            end
        end
    end

    local function anonRecolor()
        local char = plr.Character
        if not char then return end
        for _, o in ipairs(char:GetDescendants()) do
            if o:IsA("BasePart") then
                o.Color = Color3.fromRGB(math.random(1,255), math.random(1,255), math.random(1,255))
            end
        end
    end

    local function startAnon()
        if anonMode then return end
        anonMode, anonRunning = true, true
        recoloredOnce = false
        plr.Name, plr.DisplayName = "???", "???"
        hideAllOtherNames()
        if not recoloredOnce then anonRecolor(); recoloredOnce = true end
        anonStrip()
        watchAllTextObjects()

        task.spawn(function()
            while anonRunning and anonMode do
                if not plr.Parent then break end
                plr.Name, plr.DisplayName = "???", "???"
                watchAllTextObjects()
                anonStrip()
                task.wait(2)
            end
        end)

        anonConnections[#anonConnections+1] = Players.PlayerAdded:Connect(function(p)
            if anonMode then
                hidePlayerName(p)
                task.wait(0.2)
                watchAllTextObjects()
            end
        end)
        anonConnections[#anonConnections+1] = Players.PlayerRemoving:Connect(function(p)
            restorePlayerName(p)
        end)
        anonConnections[#anonConnections+1] = game.DescendantAdded:Connect(function(o)
            if anonMode then watchTextObject(o) end
        end)
        anonConnections[#anonConnections+1] = plr.CharacterAdded:Connect(function()
            task.wait(0.5)
            if not anonMode then return end
            recoloredOnce = false
            if not recoloredOnce then anonRecolor(); recoloredOnce = true end
            anonStrip()
            watchAllTextObjects()
        end)
    end

    local function stopAnon()
        anonMode, anonRunning = false, false

        for _, c in ipairs(anonConnections) do
            if c.Connected then c:Disconnect() end
        end
        anonConnections = {}

        for obj, conn in pairs(textWatchers) do
            if conn.Connected then conn:Disconnect() end
        end
        textWatchers = {}

        for obj, orig in pairs(originalTexts) do
            pcall(function()
                if obj and obj.Parent then
                    obj.Text = orig
                end
            end)
        end
        originalTexts = {}

        pcall(function()
            plr.Name = originalName
            plr.DisplayName = originalDisplay
        end)

        otherPlayersNames = {}
        fakeNameIndex = 0
    end

    local function checkPlayer(player)
        if BadIds[player.UserId] then
            addLog("⚠️ BAD ID FOUND: " .. player.Name .. " (" .. player.UserId .. ")", COLORS.Danger, 14, true, nil, "players")

            if warnMode then
                if player.UserId ~= MY_USER_ID then
                    addLog("🚪 Blacklisted player detected → leaving server", COLORS.Danger, 14, true, nil, "players")
                    pcall(function()
                        plr:Kick("Blacklisted player detected: " .. player.Name .. " (" .. player.UserId .. ")")
                    end)
                else
                    pcall(function()
                        plr:Kick("You are blacklisted")
                    end)
                end
            else
                addLog("🛡 Logs only: " .. player.Name .. " is blacklisted (no kick)", COLORS.Warning, 14, true, nil, "players")
            end
            return true
        end
        return false
    end

    local scanAll

    scanAll = function()
        local list = Players:GetPlayers()
        local total = #list
        addLog("🔍 Scanning server... (" .. total .. " players)", COLORS.Accent)
        if total == 0 then
            addLog("✅ Scan complete: server is empty.", COLORS.Success)
            return
        end
        local found, checked = 0, 0
        for _, p in ipairs(list) do
            task.spawn(function()
                if checkPlayer(p) then found = found + 1 end
                checked = checked + 1
                if checked >= total then
                    if found > 0 then
