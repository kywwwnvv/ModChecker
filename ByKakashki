    local function playGuiDissolveAnimation()
        local dissolveGui = Instance.new("ScreenGui")
        dissolveGui.Name = "ModCheckerDissolve"
        dissolveGui.ResetOnSpawn = false
        dissolveGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        dissolveGui.IgnoreGuiInset = true
        dissolveGui.DisplayOrder = 20000
        dissolveGui.Parent = PlayerGui

        local MIN_SIZE = 4
        local MAX_SIZE = 8

        local sources = {}
        if Root and Root.Visible then
            sources[#sources+1] = Root
        end
        for _, pd in pairs(panels) do
            if pd.frame and pd.frame.Visible then
                sources[#sources+1] = pd.frame
            end
        end

        local MAX_CUBES = 420

        local totalArea = 0
        local areas = {}
        for _, src in ipairs(sources) do
            local s = src.AbsoluteSize
            local a = math.max(0, s.X) * math.max(0, s.Y)
            areas[#areas+1] = a
            totalArea = totalArea + a
        end

        if totalArea <= 0 then
            if Root then Root.Visible = false end
            for _, pd in pairs(panels) do
                if pd.frame then pd.frame.Visible = false end
            end
            return dissolveGui
        end

        local budgetLeft = MAX_CUBES
        for i, src in ipairs(sources) do
            local share = math.floor(MAX_CUBES * (areas[i] / totalArea))
            if share > budgetLeft then share = budgetLeft end
            budgetLeft = budgetLeft - share

            local absPos = src.AbsolutePosition
            local absSize = src.AbsoluteSize

            if absSize.X > 0 and absSize.Y > 0 and share > 0 then
                for _ = 1, share do
                    local size = math.random(MIN_SIZE, MAX_SIZE)

                    local px = absPos.X + math.random() * math.max(1, absSize.X - size)
                    local py = absPos.Y + math.random() * math.max(1, absSize.Y - size)

                    local cube = Instance.new("Frame")
                    cube.Size = UDim2.new(0, size, 0, size)
                    cube.Position = UDim2.new(0, px, 0, py)
                    cube.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                    cube.BorderSizePixel = 0
                    cube.Rotation = math.random(0, 359)
                    cube.ZIndex = 1
                    cube.Parent = dissolveGui

                    local delay = math.random() * 0.45

                    local angle = math.random() * math.pi * 2
                    local dist = math.random(20, 220)
                    local dx = math.cos(angle) * dist
                    local dy = math.sin(angle) * dist + math.random(20, 120)

                    local finalRotation = cube.Rotation + math.random(-540, 540)

                    local flyTime = math.random(35, 95) / 100

                    task.delay(delay, function()
                        if not cube or not cube.Parent then return end
                        TweenService:Create(cube, TweenInfo.new(
                            flyTime,
                            Enum.EasingStyle.Quad,
                            Enum.EasingDirection.In
                        ), {
                            Position = UDim2.new(0, px + dx, 0, py + dy),
                            BackgroundTransparency = 1,
                            Size = UDim2.new(0, 2, 0, 2),
                            Rotation = finalRotation,
                        }):Play()
                    end)
                end
            end
        end

        if Root then
            Root.Visible = false
        end
        for _, pd in pairs(panels) do
            if pd.frame then
                pd.frame.Visible = false
            end
        end

        return dissolveGui
    end

    local function killScript()
        local dissolveGui = playGuiDissolveAnimation()

        task.wait(1.0)

        if noRenderActive then
            pcall(function() RunService:Set3dRenderingEnabled(true) end)
            noRenderActive = false
            overlayGui.Enabled = false
        end

        pcall(function() detachTrail() end)
        restoreDay()

        local wasAnon = anonMode
        if wasAnon then
            stopAnon()
        else
            anonMode, anonRunning = false, false
            for _, c in ipairs(anonConnections) do
                pcall(function() if c.Connected then c:Disconnect() end end)
            end
            anonConnections = {}
            for _, conn in pairs(textWatchers) do
                pcall(function() if conn.Connected then conn:Disconnect() end end)
            end
            textWatchers = {}
            originalTexts = {}
            pcall(function()
                plr.Name = originalName
                plr.DisplayName = originalDisplay
            end)
        end

        if wasAnon then
            pcall(function() plr:LoadCharacter() end)
            pcall(function()
                local char = plr.Character
                if char then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum then
                        hum.Health = 0
                    else
                        char:BreakJoints()
                    end
                end
            end)
        end

        for _, c in ipairs(Connections) do
            pcall(function() if c.Connected then c:Disconnect() end end)
        end
        Connections = {}

        pcall(function() if ScreenGui and ScreenGui.Parent then ScreenGui:Destroy() end end)
        pcall(function() if overlayGui and overlayGui.Parent then overlayGui:Destroy() end end)
        pcall(function() if dissolveGui and dissolveGui.Parent then dissolveGui:Destroy() end end)

        _G.__ModChecker_Unlocked = false

        if collectgarbage then
            collectgarbage("collect")
            collectgarbage("collect")
        end
    end

