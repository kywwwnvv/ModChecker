    local function addLog(text, color, size, bold, force, channel)
        local sc, counter
        if channel == "players" then
            sc = playerScroll
            playerCounter = playerCounter + 1
            counter = playerCounter
        else
            sc = scriptScroll
            scriptCounter = scriptCounter + 1
            counter = scriptCounter
        end

        local e = Instance.new("TextLabel")
        e.Size = UDim2.new(1, 0, 0, (size or 11) + 4)
        e.AutomaticSize = Enum.AutomaticSize.Y
        e.BackgroundTransparency = 1
        e.RichText = true
        e.Text = '<font color="' .. TIME_HEX .. '">[' .. os.date("%H:%M:%S") .. ']</font> ' .. text
        e.TextColor3 = color or COLORS.Text
        e.TextSize = size or 11
        e.Font = bold and Enum.Font.GothamBold or Enum.Font.Code
        e.TextXAlignment = Enum.TextXAlignment.Left
        e.TextYAlignment = Enum.TextYAlignment.Top
        e.TextWrapped = true
        e.LayoutOrder = counter
        e.Parent = sc

        local ePad = Instance.new("UIPadding", e)
        ePad.PaddingTop = UDim.new(0,2)
        ePad.PaddingBottom = UDim.new(0,2)

        if force then
            e:SetAttribute("Protected", true)
        end

        local count = 0
        for _, c in ipairs(sc:GetChildren()) do
            if c:IsA("TextLabel") then count = count + 1 end
        end
        if count > MAX_LOGS then
            for _, c in ipairs(sc:GetChildren()) do
                if c:IsA("TextLabel") and c ~= e and not c:GetAttribute("Protected") then
                    c:Destroy()
                    break
                end
            end
        end

        updateLogCanvas()
        task.spawn(function() scrollToBottom(sc) end)
        return e
    end

