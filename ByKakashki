    local function updateLogCanvas()
        local function calc(sc)
            local total = 0
            for _, c in ipairs(sc:GetChildren()) do
                if c:IsA("TextLabel") then
                    local h = c.AbsoluteSize.Y
                    if h < 1 then
                        h = (c.TextSize or 11) + 8
